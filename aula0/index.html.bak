<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <title></title>
    <link rel="stylesheet" href="dist/reveal.css" />
    <link rel="stylesheet" href="css/mattropolis.css" id="theme" />
    <link rel="stylesheet" href="plugin/highlight/zenburn.css" />
	<link rel="stylesheet" href="css/layout.css" />
	<link rel="stylesheet" href="plugin/customcontrols/style.css">



    <script defer src="dist/fontawesome/all.min.js"></script>

	<script type="text/javascript">
		var forgetPop = true;
		function onPopState(event) {
			if(forgetPop){
				forgetPop = false;
			} else {
				parent.postMessage(event.target.location.href, "app://obsidian.md");
			}
        }
		window.onpopstate = onPopState;
		window.onmessage = event => {
			if(event.data == "reload"){
				window.document.location.reload();
			}
			forgetPop = true;
		}

		function fitElements(){
			const itemsToFit = document.getElementsByClassName('fitText');
			for (const item in itemsToFit) {
				if (Object.hasOwnProperty.call(itemsToFit, item)) {
					var element = itemsToFit[item];
					fitElement(element,1, 1000);
					element.classList.remove('fitText');
				}
			}
		}

		function fitElement(element, start, end){

			let size = (end + start) / 2;
			element.style.fontSize = `${size}px`;

			if(Math.abs(start - end) < 1){
				while(element.scrollHeight > element.offsetHeight){
					size--;
					element.style.fontSize = `${size}px`;
				}
				return;
			}

			if(element.scrollHeight > element.offsetHeight){
				fitElement(element, start, size);
			} else {
				fitElement(element, size, end);
			}		
		}


		document.onreadystatechange = () => {
			fitElements();
			if (document.readyState === 'complete') {
				if (window.location.href.indexOf("?export") != -1){
					parent.postMessage(event.target.location.href, "app://obsidian.md");
				}
				if (window.location.href.indexOf("print-pdf") != -1){
					let stateCheck = setInterval(() => {
						clearInterval(stateCheck);
						window.print();
					}, 250);
				}
			}
	};


        </script>
  </head>
  <body>
    <div class="reveal">
      <div class="slides"><section  data-markdown><script type="text/template"><!-- .slide: class="drop" -->
<div class="" style="position: absolute; left: 0px; top: 0px; height: 700px; width: 960px; min-height: 700px; display: flex; flex-direction: column; align-items: center; justify-content: center" absolute="true">

<style>
@import url('https://fonts.googleapis.com/css2?family=Urbanist:wght@400;600;800&family=JetBrains+Mono:wght@400;500&display=swap');

.reveal .slides section {
  padding: 0 !important;
  background-color: #020617 !important;
  transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.reveal .slides section.present {
  opacity: 1 !important;
}

.reveal .slides section:not(.present) {
  opacity: 0 !important;
}

.slide-content {
  width: 100%;
  height: 100%;
  padding: 40px 60px !important;
  box-sizing: border-box !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  align-items: flex-start !important;
  text-align: left !important;
  position: relative;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: #00d4ff #0f172a;
}

.reveal h1 {
  font-family: 'Urbanist', sans-serif !important;
  font-weight: 800 !important;
  text-transform: uppercase !important;
  color: #ffffff !important;
  line-height: 1.1 !important;
  font-size: 74px !important;
}

.reveal h2 {
  font-family: 'Urbanist', sans-serif !important;
  font-weight: 800 !important;
  text-transform: uppercase !important;
  color: #ffffff !important;
  border-left: 10px solid #00d4ff;
  padding-left: 30px !important;
  margin-bottom: 20px !important;
  font-size: 56px !important;
}

.reveal h3 {
  font-family: 'Urbanist', sans-serif !important;
  font-weight: 700 !important;
  color: #f97316 !important;
  font-size: 37px !important;
  margin-bottom: 16px !important;
}

.reveal p, .reveal li {
  font-family: 'Urbanist', sans-serif !important;
  color: #94a3b8 !important;
  font-size: 29px !important;
  line-height: 1.5 !important;
}

.reveal ul {
  list-style: none !important;
  padding-left: 0 !important;
}

.reveal ul li::before {
  content: '▸ ' !important;
  color: #00d4ff !important;
  font-weight: bold !important;
}

.green { color: #22c55e !important; }
.orange { color: #f97316 !important; }
.blue { color: #00d4ff !important; }
.cyan { color: #06b6d4 !important; }
.mono { font-family: 'JetBrains Mono', monospace !important; text-transform: uppercase; letter-spacing: 3px; }
.divider { width: 100%; height: 1px; background: #1e293b; margin: 20px 0; }

.slide-content::after {
  content: '';
  position: absolute;
  bottom: 30px;
  left: 60px;
  width: 100px;
  height: 6px;
  background: linear-gradient(90deg, #00d4ff, #f97316);
}

.reveal .fragment {
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.reveal .fragment.visible {
  opacity: 1;
}

.reveal .fragment.fade-up {
  transform: translateY(15px);
}

.reveal .fragment.visible.fade-up {
  transform: translateY(0);
}

.quiz-option {
  background: #0f172a !important;
  border: 2px solid #1e293b !important;
  border-radius: 8px !important;
  padding: 10px 16px !important;
  margin-bottom: 8px !important;
  transition: all 0.3s ease !important;
}

.quiz-option p {
  font-size: 21px !important;
  margin: 0 !important;
}

.quiz-option.correct {
  border-color: #22c55e !important;
  background: rgba(34, 197, 94, 0.15) !important;
}

.quiz-option.incorrect {
  border-color: #ef4444 !important;
  background: rgba(239, 68, 68, 0.15) !important;
}

.unit-card {
  background: #0f172a !important;
  border: 2px solid #1e293b !important;
  border-left: 4px solid #00d4ff !important;
  border-radius: 8px !important;
  padding: 16px 20px !important;
  margin-bottom: 12px !important;
  transition: all 0.3s ease !important;
}

.unit-card:hover {
  border-color: #00d4ff !important;
  transform: translateX(5px);
}

.timeline-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #00d4ff;
  display: inline-block;
  margin-right: 12px;
}
</style>

